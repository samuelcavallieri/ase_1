; Engine configuration file.
; ÀṢẸ — O Mundo Ainda Nasce
config_version=5

[application]

config/name="ÀṢẸ — O Mundo Ainda Nasce"
run/main_scene="res://src/core/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0118, 0.0196, 0.0588, 1)

[autoload]

InputSetup="*res://src/core/autoload/input_setup.gd"
GameState="*res://src/core/autoload/game_state.gd"
SceneRouter="*res://src/core/autoload/scene_router.gd"
AudioManager="*res://src/core/autoload/audio_manager.gd"
SaveManager="*res://src/core/autoload/save_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0118, 0.0196, 0.0588, 1)

[audio]

driver/mix_rate=48000
driver/enable_input=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"
2d_physics/layer_4="interaction"
2d_physics/layer_5="trigger"
